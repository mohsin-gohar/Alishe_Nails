# ==============================================================================
#  Alishe Nails — Apache configuration (project root)
#
#  Structure on shared hosting:
#      <project-root>/.htaccess      <- this file (security + caching + rewrite)
#      <project-root>/public/         <- document root served by Apache
#
#  IMPORTANT:
#  - every <IfModule> block below is properly opened AND closed. A stray
#    closing tag makes the whole Apache config fail to parse, which takes the
#    entire site down with a 500 — keep the pairs balanced.
#  - THIS FILE works IN TANDEM with public/.htaccess (Laravel front controller).
#    The root .htaccess rewrites ALL requests into public/; public/.htaccess
#    then handles the Laravel front controller, routing, and Authorization headers.
#  - Production: AlifHost cPanel, PHP 8.2, Laravel.
#  - NEVER run migrate:fresh, db:wipe, or destructive SQL against production.
#  - Never overwrite .env or uploaded images on production without explicit approval.
# ==============================================================================

# ------------------------------------------------------------------------------
#  1. HTTPS — let cPanel/WHM enforce HTTPS, not .htaccess.
#  ------------------------------------------------------------------
#  On cPanel hosting, HTTPS is typically managed at the server level via WHM:
#  "SSL/TLS Manager" > "Auto Redirect HTTPS" or "Redirects".
#  Adding a 301 redirect here can conflict with cPanel's own redirect, causing
#  redirect loops or broken certificate handling.
#  If you must force HTTPS in .htaccess, test thoroughly in a staging environment
#  first, and ensure no conflicting redirect exists in cPanel.
# ------------------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#
#     RewriteCond %{HTTPS} !=on
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
# ------------------------------------------------------------------------------
#  For production AlifHost cPanel: configure HTTPS in WHM under "SSL/TLS Manager"
#  or "Redirects" — do not rely on .htaccess for HTTP->HTTPS redirect.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
#  2. Compression — text assets are gzipped, cutting transfer size by ~70%
#    (brotli is used when the server supports it, gzip is the fallback)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/xml
    AddOutputFilterByType BROTLI_COMPRESS application/rss+xml image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
#  3. Browser caching — fingerprinted assets are cached for a year, images for
#    a month. Repeat visitors then download almost nothing at all.
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType text/javascript         "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 month"
    ExpiresByType image/png               "access plus 1 month"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType font/woff               "access plus 1 year"
    ExpiresByType font/ttf                "access plus 1 year"
    ExpiresByType application/pdf         "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    # Fingerprinted CSS/JS can be cached forever.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(webp|jpg|jpeg|png|svg|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # The favicon and the manifest should never be cached for long.
    <FilesMatch "\.(ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # ------------------------------------------------------------------
    #  Security headers
    #
    #  These MUST stay identical to app/Http/Middleware/SecurityHeaders.php,
    #  because Apache serves CSS, JS and images directly, without ever booting
    #  Laravel. Two different policies means the browser enforces the intersection
    #  of both — a directive that only one of them allows is silently blocked.
    #  tests/Feature/SecurityHeadersTest.php asserts the .htaccess CSP exactly
    #  matches the middleware CSP.
    # ------------------------------------------------------------------
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://www.googletagmanager.com https://www.google-analytics.com https://www.clarity.ms https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://*.clarity.ms https://c.bing.com https://www.facebook.com https://connect.facebook.net https://graph.facebook.com https://graph.instagram.com; frame-src 'self' https://www.googletagmanager.com; frame-ancestors 'self'"

    # Remove the X-Powered-By fingerprint.
    Header unset X-Powered-By
</IfModule>

# ------------------------------------------------------------------------------
#  4. Security — block direct access to sensitive files and folders
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Application internals must never be reachable over HTTP.
    RewriteRule ^(\.env(\..*)?|\.git|\.gitignore|\.htaccess|\.htpasswd|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|server\.php)$ - [F,L,NC]
    RewriteRule ^(database|deploy|tests|bootstrap|config|routes|lang|node_modules|tools|docs|storage/framework|storage/logs|storage/app)/ - [F,L,NC]
    # Local database dumps, editor backups and one-off maintenance scripts must
    # never be downloadable, even if one is accidentally left in the web root.
    RewriteRule \.(sql|sqlite|bak|py)$ - [F,L,NC]

    # Preserve the Authorization header for API authentication.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Strip trailing slashes (one canonical URL per page — good for SEO).
    # Only strip if the request is NOT for a real directory (prevent 404s on
    # legitimate folder URLs that happen to end in /).
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send everything into the public directory, where the front controller lives.
    # This works together with public/.htaccess (Laravel front controller).
    RewriteCond %{REQUEST_URI} !^public/
    RewriteRule ^(.*)$ public/$1 [L,NC]
</IfModule>

# ------------------------------------------------------------------------------
#  5. Never list directory contents
# ------------------------------------------------------------------------------
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ------------------------------------------------------------------------------
#  6. Default charset
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddDefaultCharset UTF-8
</IfModule>

# ------------------------------------------------------------------------------
#  7. Upload limits — generous enough for a 20 MB product video
# ------------------------------------------------------------------------------
<IfModule mod_php.c>
    # NOTE: On cPanel/PHP-FPM, php_value directives can conflict with the
    # PHP-FPM pool settings. If you need custom PHP ini values, set them
    # in the PHP-FPM pool config or via .user.ini instead of .htaccess.
    # Keeping these here for shared-host setups that use mod_php; remove or
    # comment out if using PHP-FPM or if they cause 500 errors.
    php_value upload_max_filesize 40M
    php_value post_max_size 40M
    php_value memory_limit 512M
    php_value max_execution_time 120
</IfModule>