# ===========================================================
# Alishe Nails - Production Environment Configuration
# ===========================================================
# Do NOT commit this file. Copy to .env and fill in your values.
# Never commit real credentials to version control.
# ===========================================================

# --- Application -----------------------------------------------------------
APP_NAME="Alishe Nails"
APP_ENV=production
APP_KEY=
# Set to false in production - NEVER expose stack traces
APP_DEBUG=false
# Full URL to your site (use https:// when on production)
APP_URL=https://alishenails.com

# --- Database --------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alishe_nails
DB_USERNAME=alishe_nails_user
DB_PASSWORD=your_secure_password_here

# --- Session / Cache / Queue (use Redis for production) --------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_PATH=/

# Use Redis or database for production
CACHE_STORE=redis
QUEUE_CONNECTION=database
# Setting this makes sessions be stored in the database (more secure than file)
# SESSION_DRIVER=database

# --- Mail ------------------------------------------------------------------
# Use an SMTP service like Mailgun, Postmark, or Resend
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@alishenails.com
MAIL_PASSWORD=your_secure_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@alishenails.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Admin Account ----------------------------------------------------------
# This is the NEW hashed-password admin account - never used in .env
# Admin credentials are managed in the database via AdminSeeder
ADMIN_EMAIL=admin@alishenails.com
# A temporary initial password for the admin seeder account
ADMIN_SEED_PASSWORD=ChangeMe123!

# --- WhatsApp -------------------------------------------------------------
# Use this number for WhatsApp links: https://wa.me/923412126680
WHATSAPP_NUMBER=+923412126680

# --- Instagram (Graph API - optional) --------------------------------------
# The homepage falls back to cached database posts when this is empty.
# For Instagram API with Facebook Login: set business_account_id too.
INSTAGRAM_HANDLE=alishe_nails
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_API_BASE=https://graph.facebook.com
INSTAGRAM_GRAPH_VERSION=v21.0
INSTAGRAM_FETCH_LIMIT=12
INSTAGRAM_FEED_SIZE=8

# --- Admin Notification Email ---------------------------------------------
# Where order notifications are sent
ADMIN_NOTIFICATION_EMAIL=owner@alishenails.com

# --- Payment (optional - for reference display) -----------------------------
BANK_NAME=Meezan Bank
BANK_ACCOUNT_TITLE=Alishe Nails
BANK_ACCOUNT_NUMBER=01020304050607
BANK_IBAN=PK36MEZN0001020304050607
JAZZCASH_ACCOUNT_TITLE=Alishe Nails
JAZZCASH_NUMBER=03412126680
EASYPAISA_ACCOUNT_TITLE=Alishe Nails
EASYPAISA_NUMBER=03412126680

# --- Security headers (optional - configure via web server) ----------------
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax

# --- Production Checklist ---------------------------------------------------
# 1. Set APP_ENV=production and APP_DEBUG=false
# 2. Generate APP_KEY: php artisan key:generate
# 3. Run migrations: php artisan migrate --force
# 4. Publish assets: php artisan view:clear && php artisan config:clear
# 5. Build assets: npm run build
# 6. Link storage: php artisan storage:link
# 7. Setup queue worker: php artisan queue:work --daemon
# 8. Setup scheduler cron: * * * * * cd /path/to/alishe-nails && php artisan schedule:run >> /dev/null 2>&1
# 9. Setup supervisor for queue: See README.md "Production Deployment"
# 10. Set SESSION_SECURE_COOKIE=true once HTTPS is working
# 11. Use a real SMTP service (not log) for transactional emails
