# ===========================================================
# Alishe Nails - Production Environment Configuration
# ===========================================================
# Do NOT commit this file. Copy to .env and fill in your values.
# Never commit real credentials to version control.
# ===========================================================

# --- Application -----------------------------------------------------------
APP_NAME="Alishe Nails"
APP_ENV=production
APP_KEY=
# Set to false in production - NEVER expose stack traces
APP_DEBUG=false
# Full canonical HTTPS URL to your site (no trailing slash)
APP_URL=https://yourdomain.com

# --- Database --------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alishe_nails
DB_USERNAME=alishe_nails_user
DB_PASSWORD=your_secure_password_here

# --- Session / Cache / Queue -----------------------------------------------
# For best performance use redis for session/cache/queue where available.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set true in production when APP_URL is https://
SESSION_SECURE_COOKIE=true
SESSION_PATH=/

CACHE_STORE=file
QUEUE_CONNECTION=database

# Redis Server Configuration (for SESSION_DRIVER=redis and CACHE_STORE=redis)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ------------------------------------------------------------------
# Use an SMTP service like Mailgun, Postmark, or Resend
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@alishenails.com
MAIL_PASSWORD=your_secure_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@alishenails.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Admin Account ----------------------------------------------------------
# Admin credentials are managed in the database via AdminSeeder.
# Set a unique, strong password before seeding in any shared/production environment.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_SEED_PASSWORD=

# --- WhatsApp -------------------------------------------------------------
# Use this number for WhatsApp links: https://wa.me/923113925166
WHATSAPP_NUMBER=+923113925166

# --- Instagram (Graph API - optional) --------------------------------------
# The homepage falls back to cached database posts when this is empty.
# For Instagram API with Facebook Login: set business_account_id too.
INSTAGRAM_HANDLE=alishe_nails
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_API_BASE=https://graph.facebook.com
INSTAGRAM_GRAPH_VERSION=v21.0
INSTAGRAM_FETCH_LIMIT=12
INSTAGRAM_FEED_SIZE=8

# --- Admin Notification Email ---------------------------------------------
# Where order notifications are sent
ADMIN_NOTIFICATION_EMAIL=owner@alishenails.com

# --- Analytics (optional) --------------------------------------------------
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
CLARITY_PROJECT_ID=

# --- Deployment helper (remove after deploy) -----------------------------
# Temporary token for the /_deploy web endpoint. Set a long random string,
# use it once, then remove this line and the /_deploy route.
DEPLOY_TOKEN=
RELOAD_LIMIT_PER_MINUTE=30

# --- Payment (optional - for reference display) -----------------------------
BANK_NAME=Meezan Bank
BANK_ACCOUNT_TITLE=Alishe Nails
BANK_ACCOUNT_NUMBER=01020304050607
BANK_IBAN=PK36MEZN0001020304050607
JAZZCASH_ACCOUNT_TITLE="Alishba Naz"
JAZZCASH_NUMBER=03412126680
JAZZCASH_IBAN=PK76JCMA1908923412126680
SADAPAY_ACCOUNT_TITLE="Alishba Naz"
SADAPAY_NUMBER=03113925166
SADAPAY_IBAN=PK46SADA0000003113925166
EASYPAISA_ACCOUNT_TITLE="Alishba Naz"
EASYPAISA_NUMBER=03113925166

# --- Production Checklist ---------------------------------------------------
# 1. Set APP_ENV=production and APP_DEBUG=false
# 2. Generate APP_KEY: php artisan key:generate
# 3. Run migrations: php artisan migrate --force
# 4. Publish assets: php artisan view:clear && php artisan config:clear && php artisan route:clear
# 5. Link storage: php artisan storage:link
# 6. Setup queue worker: php artisan queue:work --daemon
# 7. Setup scheduler cron: * * * * * cd /path/to/alishe-nails && php artisan schedule:run >> /dev/null 2>&1
# 8. Setup supervisor for queue: See README.md "Production Deployment"
# 9. Set SESSION_SECURE_COOKIE=true once HTTPS is working
# 10. Use a real SMTP service (not log) for transactional emails
#
# --- Image pipeline (WebP) --------------------------------------------------
# The catalogue is served as WebP. This needs the GD extension with WebP
# support — check with: php -r "print_r(gd_info());"
# If "WebP Support" is false, enable extension=gd in php.ini.
#
# Convert the images that were uploaded before the pipeline existed:
#     php artisan images:optimize --prune
#
# New uploads are converted automatically the moment they are saved.

# --- Fonts ------------------------------------------------------------------
# Fonts and Font Awesome are self-hosted in public/webfonts — no third-party
# requests, so nothing needs to be configured here.
